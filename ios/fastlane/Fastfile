default_platform(:ios)

platform :ios do
  desc "Build, sign with match, and upload to TestFlight (pilot)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
    )

    # Fetch the distribution certificate + provisioning profile (read-only).
    match(type: "appstore", readonly: true, api_key: api_key)

    # Flutter compiles the Xcode project; gym archives & signs it.
    sh("flutter", "build", "ios", "--release", "--no-codesign",
       "--build-number=#{ENV['BUILD_NUMBER'] || '1'}")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "App Store release — DISABLED until store listing + credentials are ready"
  lane :release do
    UI.user_error!(
      "App Store deliver lane is intentionally inactive (locked Phase-8 decision). " \
      "Enable it once the listing and credentials are confirmed."
    )
  end
end
